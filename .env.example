# EarnLaw Frontend Environment Configuration
# Set to 'true' to use realistic mock data (ideal for frontend development)
# Set to 'false' to connect to real backend APIs developed by Members 2, 3, and 4
VITE_USE_MOCK_API=false
# In local development: http://localhost:5000/api
# In production:
# - Leave empty or '/api' to use Vercel rewrites (destination: https://vidhisetu-app.onrender.com/api) or unified Docker serving
# - Or specify the deployed backend URL directly: https://vidhisetu-app.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api
# Public Google OAuth Web client ID; configure the same ID in backend/.env.
VITE_GOOGLE_CLIENT_ID=
