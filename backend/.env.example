# =============================================================================
# EarnLaw Member 2: Central Backend & AnuDB Configuration
# =============================================================================

PORT=5000
NODE_ENV=development

# AnuDB (PostgreSQL) Connection Details
# Option A: Standard cloud connection string (Render, Neon, Supabase, Railway)
DATABASE_URL=postgresql://user:password@host:5432/anudb?sslmode=require

# Option B: Individual connection parameters (Local development)
ANUDB_HOST=localhost
ANUDB_PORT=5432
ANUDB_DATABASE=anudb
ANUDB_USER=postgres
ANUDB_PASSWORD=replace-with-local-database-password
ANUDB_SSL=false
ANUDB_POOL_MAX=20

# Secure Document Upload Directory (mount persistent disk on Render / Docker)
VIDHISETU_UPLOAD_DIR=/data/uploads

# JWT Authentication
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=adminvidhisetu@gmail.com

# Google OAuth Web client ID; must match root VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# SMS notifications (Fast2SMS / Twilio). Phone OTP login is disabled.
FAST2SMS_API_KEY=WvmIXhPcIdrXXT7e53WpbWCKUeu1vlgfD1YBTuI2K0ZX7JQTRlD3HM3kXVpf
FAST2SMS_ROUTE=otp
ENABLE_DEMO_OTP=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Microservice & Module Endpoints (Members 3 & 4)
MEMBER3_AI_RAG_ENABLED=true
MEMBER4_LAWYER_CASE_PORT=5002

# Fallback & Mock Controls (Set to false when AnuDB PostgreSQL instance is live)
USE_MEMORY_FALLBACK=false

# Indian Kanoon API (Official: https://api.indiankanoon.org/documentation/)
# Never expose this token in frontend code.
INDIANKANOON_API_TOKEN=your_indian_kanoon_token_here

# Google Gemini LLM API (Official @google/genai SDK)
# Used by Member 3 AI + RAG legal synthesis pipeline. Backend only; never expose in frontend.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# =============================================================================
# Payment Gateway Configuration (Razorpay / VidhiSetu Gateway Engine)
# =============================================================================
# Never expose RAZORPAY_KEY_SECRET to frontend code or commit to source control.
RAZORPAY_KEY_ID=replace-with-provider-key-id
RAZORPAY_KEY_SECRET=replace-with-provider-secret
PAYMENT_SANDBOX_MODE=true
PLATFORM_FEE_PERCENTAGE=10
GST_PERCENTAGE=18
